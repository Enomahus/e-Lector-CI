# Étape 1 : Build de l'application Angular
FROM node:22-alpine AS build

# Définir le répertoire de travail
WORKDIR /app

# Copier les fichiers de dépendances
COPY package.json package-lock.json ./

# Installer les dépendances de manière propre (recommandé pour les builds)
RUN npm ci

# Copier le reste du code source du projet
COPY . .

# Construire l'application Angular pour la production
RUN npm run build -- --configuration production

# Étape 2 : Serveur Nginx pour distribuer les fichiers statiques
FROM nginx:alpine

# (Optionnel) Copier votre configuration Nginx personnalisée pour gérer le routage d'Angular
# COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copier les fichiers de build depuis l'étape précédente
# ATTENTION : Remplacez "votre-projet" par le nom défini dans votre fichier angular.json.
# Depuis Angular 17+, les fichiers compilés se trouvent généralement dans le sous-dossier "/browser"
COPY --from=build /app/dist/web-client/browser /usr/share/nginx/html

# Exposer le port 80
EXPOSE 80

# Démarrer Nginx
CMD ["nginx", "-g", "daemon off;"]
